# Copy to .env.local and fill in from your Supabase project:
#   Dashboard -> Project Settings -> Data API
#
# Both values are safe in the browser and in a public repo. The anon key is
# designed to be published; row-level security in supabase/schema.sql is what
# keeps one account from reading another's calendar. Never put the
# service_role key here -- that one bypasses RLS.
#
# Leave these unset and the app runs local-only, exactly as before.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
